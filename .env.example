# --- Bungie ---
# Free key: https://www.bungie.net/en/Application (App type: not applicable for Phase 1, no OAuth yet)
BUNGIE_API_KEY=put-your-key-here

# Languages: comma-separated. 'en' is mandatory (retrieval corpus) and is
# forced first even if you omit it. Extra languages are download-only
# lookup layers for the wiki + Ghost terminology (see README rule #1).
LANGUAGES=en

# --- LLM backend (OpenAI-compatible) ---
# Local default (Ollama):
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b-instruct-q5_K_M
LLM_API_KEY=ollama
# Commercial API example (uncomment + fill to compare quality):
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-4-5
# LLM_API_KEY=sk-...

# --- Embeddings (always local) ---
EMBEDDING_MODEL=BAAI/bge-m3
